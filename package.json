{
  "name": "perpetual-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "A native workspace for persistent Codex and Claude Code tasks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SakethSripada/Perpetual-Desktop.git"
  },
  "homepage": "https://github.com/SakethSripada/Perpetual-Desktop#readme",
  "bugs": {
    "url": "https://github.com/SakethSripada/Perpetual-Desktop/issues"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/setup.mjs --launch",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "check": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
